# No credentials are required for the offline synthetic demo.
# Historical replay defaults to OpenF1 public research data; FastF1 is optional.
F1_DATA_DIR=data/derived

# The AI brief is OFF by default. Export these in the server environment.
# Never commit a real key. This file is a reference; .env is not auto-loaded.
APEX_LLM_ENABLED=false
APEX_LLM_API_KEY=replace-with-your-own-key
APEX_LLM_MODEL=your-provider-model-id
APEX_LLM_BASE_URL=https://api.openai.com/v1
