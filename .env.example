# Historical OpenF1 replay: optional, no API credentials required.
F1_DATA_DIR=data/derived

# SovInfra is the default research LLM provider for the optional AI Race Engineer.
# OFF until explicitly enabled. DO NOT put an API key into this tracked file.
# Export the key privately in your operating-system shell environment.
APEX_LLM_ENABLED=false
APEX_LLM_MODEL=sovapi
APEX_LLM_BASE_URL=https://api.sovinfra.ai/v1

# APEX_LLM_API_KEY is intentionally NOT set here.
# SOVINFRA_API_KEY can alternatively be used as a private environment variable.
# Generic OpenAI-compatible providers can override MODEL and BASE_URL.
